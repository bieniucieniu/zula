import kotlin.uuid.Uuid;
CREATE TABLE users (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    username TEXT NOT NULL UNIQUE
);

CREATE TABLE user_profiles (
    user_id UUID AS Uuid NOT NULL PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
    display_name TEXT,
    avatar_url TEXT,
    bio TEXT,
    timezone TEXT,
    preferred_language TEXT,
    location_tag TEXT,
    seller_headline TEXT,
    updated_at BIGINT NOT NULL
);

CREATE TABLE user_identities (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    user_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    provider TEXT NOT NULL,
    provider_user_id TEXT NOT NULL,
    email TEXT,
    provider_metadata TEXT,
    provider_refresh_token_enc TEXT,
    provider_access_token_enc TEXT,
    provider_token_expires_at BIGINT,
    credentials_status TEXT NOT NULL DEFAULT 'missing',
    credentials_checked_at BIGINT,
    credentials_revoked_at BIGINT,
    scopes TEXT,
    UNIQUE (provider, provider_user_id)
);

CREATE TABLE user_sessions (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    user_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    identity_id UUID AS Uuid REFERENCES user_identities(id) ON DELETE SET NULL,
    auth_method TEXT NOT NULL,
    refresh_token_hash TEXT UNIQUE,
    device_info TEXT,
    ip_address TEXT,
    expires_at BIGINT NOT NULL,
    is_revoked BIGINT NOT NULL DEFAULT 0,
    rotated_from_id UUID AS Uuid
);

CREATE TABLE user_stats (
    user_id UUID AS Uuid NOT NULL PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
    explicit_rating_avg REAL NOT NULL DEFAULT 5.0,
    implicit_trust_score BIGINT NOT NULL DEFAULT 100,
    last_calculated_at BIGINT NOT NULL
);

CREATE TABLE user_blocks (
    blocker_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    blocked_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    PRIMARY KEY (blocker_id, blocked_id)
);

CREATE TABLE user_ratings (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    reviewer_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    reviewee_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    rating BIGINT NOT NULL,
    comment TEXT,
    UNIQUE (reviewer_id, reviewee_id)
);

CREATE TABLE seller_activity_stats (
    user_id UUID AS Uuid NOT NULL PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
    active_offer_count BIGINT NOT NULL DEFAULT 0,
    active_need_count BIGINT NOT NULL DEFAULT 0,
    active_trip_count BIGINT NOT NULL DEFAULT 0,
    fulfilled_item_count BIGINT NOT NULL DEFAULT 0,
    completed_trade_count BIGINT NOT NULL DEFAULT 0,
    updated_at BIGINT NOT NULL
);

CREATE INDEX user_identities_user_id ON user_identities(user_id);
CREATE INDEX user_sessions_user_id ON user_sessions(user_id);
CREATE INDEX user_sessions_identity_id ON user_sessions(identity_id);
CREATE INDEX user_blocks_blocked_id ON user_blocks(blocked_id);
CREATE INDEX user_ratings_reviewee_id ON user_ratings(reviewee_id, id);
