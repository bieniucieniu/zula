import kotlin.uuid.Uuid;

CREATE TABLE users (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    username TEXT NOT NULL UNIQUE
);

CREATE TABLE user_profiles (
    user_id UUID AS Uuid NOT NULL PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
    display_name TEXT,
    avatar_url TEXT,
    timezone TEXT,
    preferred_language TEXT,
    location_tag TEXT,
    seller_headline TEXT,
    updated_at BIGINT NOT NULL
);

CREATE TABLE user_identities (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    user_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    provider TEXT NOT NULL,
    provider_user_id TEXT NOT NULL,
    email TEXT,
    provider_metadata TEXT,
    provider_refresh_token_enc TEXT,
    provider_access_token_enc TEXT,
    provider_token_expires_at BIGINT,
    credentials_status TEXT NOT NULL DEFAULT 'missing',
    credentials_checked_at BIGINT,
    credentials_revoked_at BIGINT,
    scopes TEXT,
    UNIQUE (provider, provider_user_id)
);

CREATE TABLE user_sessions (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    user_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    identity_id UUID AS Uuid REFERENCES user_identities(id) ON DELETE SET NULL,
    auth_method TEXT NOT NULL,
    refresh_token_hash TEXT UNIQUE,
    device_info TEXT,
    ip_address TEXT,
    expires_at BIGINT NOT NULL,
    is_revoked BIGINT NOT NULL DEFAULT 0,
    rotated_from_id UUID AS Uuid
);

CREATE TABLE user_stats (
    user_id UUID AS Uuid NOT NULL PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
    explicit_rating_avg REAL NOT NULL DEFAULT 5.0,
    implicit_trust_score BIGINT NOT NULL DEFAULT 100,
    last_calculated_at BIGINT NOT NULL
);

CREATE TABLE user_blocks (
    blocker_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    blocked_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    PRIMARY KEY (blocker_id, blocked_id)
);

CREATE TABLE user_ratings (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    reviewer_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    reviewee_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    rating BIGINT NOT NULL,
    comment TEXT,
    UNIQUE (reviewer_id, reviewee_id)
);

CREATE TABLE seller_activity_stats (
    user_id UUID AS Uuid NOT NULL PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
    active_offer_count BIGINT NOT NULL DEFAULT 0,
    active_need_count BIGINT NOT NULL DEFAULT 0,
    active_trip_count BIGINT NOT NULL DEFAULT 0,
    fulfilled_item_count BIGINT NOT NULL DEFAULT 0,
    completed_trade_count BIGINT NOT NULL DEFAULT 0,
    updated_at BIGINT NOT NULL
);

CREATE TABLE documents (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    owner_user_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    format TEXT NOT NULL DEFAULT 'markdown' CHECK (format = 'markdown'),
    source TEXT NOT NULL DEFAULT '',
    revision BIGINT NOT NULL DEFAULT 1,
    updated_at BIGINT NOT NULL
);

CREATE TABLE document_revisions (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    document_id UUID AS Uuid NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
    revision BIGINT NOT NULL,
    source TEXT NOT NULL,
    created_at BIGINT NOT NULL
);

CREATE TABLE user_profile_bio (
    user_id UUID AS Uuid NOT NULL PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
    document_id UUID AS Uuid NOT NULL REFERENCES documents(id) ON DELETE RESTRICT,
    updated_at BIGINT NOT NULL
);

CREATE TABLE user_portfolio_items (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    user_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    kind TEXT NOT NULL CHECK (kind IN ('creation', 'offer', 'case_study', 'external_link')),
    title TEXT NOT NULL,
    summary TEXT,
    body_document_id UUID AS Uuid REFERENCES documents(id) ON DELETE SET NULL,
    feed_item_id UUID AS Uuid,
    trade_id UUID AS Uuid,
    external_url TEXT,
    cover_object_key TEXT,
    sort_order BIGINT NOT NULL DEFAULT 0,
    visibility TEXT NOT NULL DEFAULT 'public' CHECK (visibility IN ('public', 'unlisted')),
    updated_at BIGINT NOT NULL
);

CREATE TABLE user_profile_pins (
    user_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    portfolio_item_id UUID AS Uuid NOT NULL REFERENCES user_portfolio_items(id) ON DELETE CASCADE,
    sort_order BIGINT NOT NULL DEFAULT 0,
    PRIMARY KEY (user_id, portfolio_item_id)
);

CREATE INDEX user_identities_user_id ON user_identities(user_id);
CREATE INDEX user_sessions_user_id ON user_sessions(user_id);
CREATE INDEX user_sessions_identity_id ON user_sessions(identity_id);
CREATE INDEX user_blocks_blocked_id ON user_blocks(blocked_id);
CREATE INDEX user_ratings_reviewee_id ON user_ratings(reviewee_id, id);
CREATE INDEX document_revisions_document_id ON document_revisions(document_id, revision);
CREATE INDEX user_portfolio_items_user_id ON user_portfolio_items(user_id, id DESC);
CREATE INDEX user_portfolio_items_user_public ON user_portfolio_items(user_id, id DESC)
    WHERE visibility = 'public';
CREATE INDEX user_profile_pins_order ON user_profile_pins(user_id, sort_order);

CREATE TABLE media_objects (
    object_key TEXT NOT NULL PRIMARY KEY,
    owner_user_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    status TEXT NOT NULL CHECK (status IN ('pending', 'active', 'deleted')),
    content_type TEXT,
    byte_size BIGINT,
    ref_count BIGINT NOT NULL DEFAULT 0,
    created_at BIGINT NOT NULL,
    committed_at BIGINT,
    delete_after BIGINT
);

CREATE INDEX media_objects_owner_idx ON media_objects(owner_user_id, status);
CREATE INDEX media_objects_gc_idx ON media_objects(status, delete_after)
    WHERE status IN ('pending', 'deleted');

CREATE TABLE traits (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    parent_id UUID AS Uuid,
    slug TEXT NOT NULL UNIQUE,
    label TEXT NOT NULL,
    sort_order BIGINT NOT NULL DEFAULT 0,
    FOREIGN KEY (parent_id) REFERENCES traits(id) ON DELETE CASCADE
);

CREATE INDEX traits_parent_idx ON traits(parent_id, sort_order);

CREATE TABLE groups (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    slug TEXT NOT NULL UNIQUE,
    title TEXT NOT NULL,
    description TEXT,
    visibility TEXT NOT NULL CHECK (visibility IN ('public', 'private')),
    created_by UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    created_at BIGINT NOT NULL
);

CREATE TABLE group_members (
    group_id UUID AS Uuid NOT NULL REFERENCES groups(id) ON DELETE CASCADE,
    user_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    role TEXT NOT NULL CHECK (role IN ('owner', 'admin', 'member')),
    joined_at BIGINT NOT NULL,
    PRIMARY KEY (group_id, user_id)
);

CREATE INDEX group_members_user_idx ON group_members(user_id, group_id);

CREATE TABLE feed_items (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    author_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    group_id UUID AS Uuid REFERENCES groups(id) ON DELETE SET NULL,
    kind TEXT NOT NULL CHECK (kind IN ('need', 'offer', 'trip')),
    title TEXT NOT NULL,
    body TEXT,
    status TEXT NOT NULL DEFAULT 'active'
        CHECK (status IN ('active', 'fulfilled', 'expired', 'removed', 'in_trade')),
    visibility TEXT NOT NULL DEFAULT 'public'
        CHECK (visibility IN ('public', 'followers', 'private')),
    origin_tag TEXT,
    dest_tag TEXT,
    available_from BIGINT,
    available_until BIGINT,
    like_count BIGINT NOT NULL DEFAULT 0,
    comment_count BIGINT NOT NULL DEFAULT 0,
    last_bumped_at BIGINT NOT NULL,
    default_location_mode TEXT
        CHECK (default_location_mode IS NULL OR default_location_mode IN ('provider', 'client', 'negotiated')),
    updated_at BIGINT NOT NULL
);

CREATE INDEX feed_items_chrono_idx ON feed_items(id DESC)
    WHERE status = 'active' AND visibility = 'public';
CREATE INDEX feed_items_author_idx ON feed_items(author_id, id DESC);
CREATE INDEX feed_items_group_idx ON feed_items(group_id, id DESC);
CREATE INDEX feed_items_bumped_idx ON feed_items(last_bumped_at DESC, id DESC)
    WHERE status = 'active' AND visibility = 'public';

CREATE TABLE feed_item_traits (
    feed_item_id UUID AS Uuid NOT NULL REFERENCES feed_items(id) ON DELETE CASCADE,
    trait_id UUID AS Uuid NOT NULL REFERENCES traits(id) ON DELETE CASCADE,
    PRIMARY KEY (feed_item_id, trait_id)
);

CREATE INDEX feed_item_traits_trait_idx ON feed_item_traits(trait_id, feed_item_id);

CREATE TABLE feed_item_media (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    feed_item_id UUID AS Uuid NOT NULL REFERENCES feed_items(id) ON DELETE CASCADE,
    object_key TEXT NOT NULL,
    sort_order BIGINT NOT NULL DEFAULT 0
);

CREATE INDEX feed_item_media_item_idx ON feed_item_media(feed_item_id, sort_order);

CREATE TABLE user_trait_follows (
    user_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    trait_id UUID AS Uuid NOT NULL REFERENCES traits(id) ON DELETE CASCADE,
    created_at BIGINT NOT NULL,
    PRIMARY KEY (user_id, trait_id)
);

CREATE TABLE user_interest_profiles (
    user_id UUID AS Uuid NOT NULL PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
    source TEXT NOT NULL DEFAULT 'onboarding',
    updated_at BIGINT NOT NULL
);

CREATE TABLE feed_item_likes (
    feed_item_id UUID AS Uuid NOT NULL REFERENCES feed_items(id) ON DELETE CASCADE,
    user_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    created_at BIGINT NOT NULL,
    PRIMARY KEY (feed_item_id, user_id)
);

CREATE TABLE feed_item_comments (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    feed_item_id UUID AS Uuid NOT NULL REFERENCES feed_items(id) ON DELETE CASCADE,
    author_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    body TEXT NOT NULL
);

CREATE INDEX feed_item_comments_item_idx ON feed_item_comments(feed_item_id, id DESC);

CREATE TABLE feed_item_bookmarks (
    user_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    feed_item_id UUID AS Uuid NOT NULL REFERENCES feed_items(id) ON DELETE CASCADE,
    created_at BIGINT NOT NULL,
    PRIMARY KEY (user_id, feed_item_id)
);

CREATE INDEX feed_item_bookmarks_user_idx ON feed_item_bookmarks(user_id, feed_item_id DESC);

CREATE TABLE trades (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    template TEXT NOT NULL CHECK (template IN ('swap', 'meetup_cash')),
    status TEXT NOT NULL DEFAULT 'proposed'
        CHECK (status IN ('proposed', 'accepted', 'scheduled', 'completed', 'cancelled', 'expired')),
    location_mode TEXT
        CHECK (location_mode IS NULL OR location_mode IN ('provider', 'client', 'negotiated')),
    initiator_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    counterparty_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    feed_item_id UUID AS Uuid REFERENCES feed_items(id) ON DELETE SET NULL,
    meetup_proposed_at BIGINT,
    meetup_confirmed_at BIGINT,
    created_at BIGINT NOT NULL,
    updated_at BIGINT NOT NULL
);

CREATE INDEX trades_initiator_idx ON trades(initiator_id, id DESC);
CREATE INDEX trades_counterparty_idx ON trades(counterparty_id, id DESC);
CREATE INDEX trades_feed_item_idx ON trades(feed_item_id);

CREATE TABLE trade_participants (
    trade_id UUID AS Uuid NOT NULL REFERENCES trades(id) ON DELETE CASCADE,
    user_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    role TEXT NOT NULL CHECK (role IN ('initiator', 'counterparty')),
    PRIMARY KEY (trade_id, user_id)
);

CREATE TABLE trade_items (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    trade_id UUID AS Uuid NOT NULL REFERENCES trades(id) ON DELETE CASCADE,
    feed_item_id UUID AS Uuid REFERENCES feed_items(id) ON DELETE SET NULL,
    side TEXT NOT NULL CHECK (side IN ('initiator', 'counterparty', 'shared')),
    label TEXT
);

CREATE TABLE trade_locations (
    trade_id UUID AS Uuid NOT NULL PRIMARY KEY REFERENCES trades(id) ON DELETE CASCADE,
    place_note TEXT,
    place_ciphertext TEXT,
    updated_at BIGINT NOT NULL
);

CREATE TABLE chat_rooms (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    trade_id UUID AS Uuid UNIQUE REFERENCES trades(id) ON DELETE CASCADE,
    group_id UUID AS Uuid UNIQUE REFERENCES groups(id) ON DELETE CASCADE,
    created_at BIGINT NOT NULL,
    CHECK (
        (trade_id IS NOT NULL AND group_id IS NULL)
        OR (trade_id IS NULL AND group_id IS NOT NULL)
    )
);

CREATE TABLE chat_participants (
    room_id UUID AS Uuid NOT NULL REFERENCES chat_rooms(id) ON DELETE CASCADE,
    user_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    joined_at BIGINT NOT NULL,
    PRIMARY KEY (room_id, user_id)
);

CREATE INDEX chat_participants_user_idx ON chat_participants(user_id, room_id);

CREATE TABLE chat_messages (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    room_id UUID AS Uuid NOT NULL REFERENCES chat_rooms(id) ON DELETE CASCADE,
    sender_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    body TEXT NOT NULL,
    client_message_id TEXT NOT NULL,
    UNIQUE (room_id, sender_id, client_message_id)
);

CREATE INDEX chat_messages_room_idx ON chat_messages(room_id, id DESC);

CREATE TABLE sse_event_log (
    id UUID AS Uuid NOT NULL PRIMARY KEY DEFAULT uuidv7(),
    user_id UUID AS Uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    event_type TEXT NOT NULL,
    payload TEXT NOT NULL,
    created_at BIGINT NOT NULL
);

CREATE INDEX sse_event_log_user_idx ON sse_event_log(user_id, id DESC);

