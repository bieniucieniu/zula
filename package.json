{
  "name": "zula",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "gen:api": "orval --config packages/api/orval.config.ts",
    "gen:powersync": "powersync generate schema --output=ts --output-path=packages/powersync/src/generated/schema.ts --directory=./powersync --api-url=http://127.0.0.1:8080"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "orval": "^8.22.0",
    "powersync": "^0.9.0"
  }
}
