{
  "name": "zula",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@types/react": "19.2.3",
      "@types/react-dom": "19.2.3",
      "@tanstack/react-query": "5.101.4",
      "@tanstack/react-query-devtools": "5.101.4",
      "@tanstack/react-query-persist-client": "5.101.4",
      "@tanstack/query-async-storage-persister": "5.101.4",
      "typescript": "~6.0.3",
      "orval": "^8.23.0",
      "vitest": "^4.1.10",
      "storybook": "^10.5.4",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "tailwind-merge": "^3.6.0",
      "tailwindcss": "^4.3.3",
      "tw-animate-css": "^1.4.0",
      "babel-plugin-react-compiler": "^1.0.0"
    },
    "catalogs": {
      "web": {
        "@tanstack/react-devtools": "0.10.9",
        "@tanstack/react-form": "1.33.2",
        "@tanstack/react-pacer": "0.22.1",
        "@tanstack/react-router": "1.170.18",
        "@tanstack/react-router-devtools": "1.167.0",
        "@tanstack/react-router-ssr-query": "1.167.1",
        "@tanstack/react-start": "1.168.32",
        "@tanstack/router-plugin": "1.168.23",
        "@tanstack/devtools-vite": "0.8.3",
        "zustand": "5.0.14"
      }
    }
  },
  "scripts": {
    "build": "tsdown -W 'packages/*'",
    "build:packages": "bun run --filter '@zula/*' build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "gen:api": "orval --config packages/api/orval.config.ts",
    "web": "bun run --filter zula-web dev",
    "native": "bun run --filter zula-native dev",
    "ios": "bun run --filter zula-native ios",
    "android": "bun run --filter zula-native android",
    "deps:docker": "docker compose up",
    "deps:docker:down": "docker compose down",
    "deps:docker:reset": "docker compose down -v"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "orval": "catalog:",
    "tsdown": "^0.22.14",
    "unrun": "^0.3.1"
  },
  "overrides": {}
}
