# Local dummy env for Zula. Copy to `.env`.
# Loaded by SecretSpec via devenv (devenv.yaml: secretspec.provider=dotenv).

# --- URLs ---
APP_URL=http://localhost:8000
API_URL=http://localhost:8000/api
# Expo (apps/native): Metro inlines EXPO_PUBLIC_* at start.
# devenv --profile native sets these from LAN IP if unset.
# Override when needed (Android emulator often wants 10.0.2.2):
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
# EXPO_PUBLIC_API_URL=

# --- PostgreSQL (devenv services.postgres, or docker/docker-compose.yaml) ---
DATABASE_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/zula
DATABASE_USERNAME=zula
DATABASE_PASSWORD=zula
DATABASE_MAX_POOL_SIZE=10
AUTO_MIGRATE=true

# --- JobRunr (Postgres-backed; dashboard optional) ---
JOBRUNR_DASHBOARD=false
JOBRUNR_DASHBOARD_PORT=8008

# --- JWT (ephemeral keys OK for local) ---
JWT_AUDIENCE=zula
JWT_REALM=Zula
JWT_AUTO_GENERATE_KEY=true
JWT_SIGNING_ENABLED=true
JWT_KEY_ID=default
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=
# JWT_KEYS=

PROVIDER_TOKEN_ENCRYPTION_KEY=local-dev-only-change-me

# --- Dev auth bypass (local only; never set in production) ---
# Same secret on server + native. Issues real JWT for a fixed dev user.
AUTH_DEV_BYPASS_SECRET=local-dev-bypass
AUTH_DEV_BYPASS_EMAIL=dev@zula.local
EXPO_PUBLIC_DEV_AUTH_SECRET=local-dev-bypass
EXPO_PUBLIC_DEV_AUTH_EMAIL=dev@zula.local

# --- K8s JWT secret store (off locally) ---
JWT_K8S_ENABLED=false
JWT_K8S_NAMESPACE=
JWT_K8S_SECRET_NAME=zula-jwt-keys
JWT_K8S_AUTO_PULL=true
JWT_K8S_AUTO_PUSH=false

# --- OAuth (empty = providers disabled) ---
# GOOGLE_CLIENT_ID must be a "Web application" OAuth client (used by web + native id_token aud).
# Web popup redirect URIs:
#   http://localhost:3000/oauth/callback
#   http://127.0.0.1:3000/oauth/callback
# Native (Expo) redirect URI — must match apps/native scheme `zula`:
#   zula://oauth
# Optional platform-specific Google clients (aud accepted via GOOGLE_ADDITIONAL_CLIENT_IDS):
#   EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
#   EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
#   EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=   # override; defaults to GOOGLE_CLIENT_ID from /auth/providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated extra Google OAuth client IDs (iOS/Android/web) accepted as id_token aud
GOOGLE_ADDITIONAL_CLIENT_IDS=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_ADDITIONAL_CLIENT_IDS=
